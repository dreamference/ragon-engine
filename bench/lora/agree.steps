# The adapters' bar, agreement (bar.sh): the engine teacher-forced on the reference's greedy continuations with the
# reference's top-20 scored (ragon_force score, LORA §6 item 3), and the agent prompts' first answers, on rand-x32 (see
# ref.steps). The control is the engine without the adapter on the same cases: it has to fail the gate, or the gate could
# not have told the adapter from its absence.
source $(dirname ${BASH_SOURCE[0]})/common.sh
A=$HOME/lora-agree; REF=${LORA_REF:-$HOME/lora-ref-x32}
python3 - $A $REF $V <<'PY'
import json, sys
A, REF, V = sys.argv[1:]
ids = [json.loads(l)["ids"] for l in open(f"{A}/ids.jsonl")]
gen = [json.loads(l) for l in open(f"{REF}/ref-lora.jsonl")]
ref = [json.loads(l) for l in open(f"{REF}/force-lora.jsonl")]
with open(f"{V}/cases-lora.jsonl", "w") as f:
    for p, g, r in zip(ids, gen, ref):
        f.write(json.dumps({"prompt": p, "cont": g["cont"], "want": [[c[0] for c in pos] for pos in r["top"]]}) + "\n")
with open(f"{V}/cases-long.jsonl", "w") as f:
    for l in open(f"{A}/ids-long.jsonl"):
        f.write(json.dumps({"prompt": json.loads(l)["ids"]}) + "\n")
PY
force_lora() { RAGON_LORA=$LIB/rand-x32 $B/ragon-force score $M 20 < $V/cases-lora.jsonl > $V/eng-lora.jsonl; }
control() { $B/ragon-force score $M 20 < $V/cases-lora.jsonl > $V/eng-control.jsonl; }
long_lora() { RAGON_LORA=$LIB/rand-x32 $B/ragon-force gen $M 400 < $V/cases-long.jsonl > $V/long-lora.jsonl; }
step force-lora force_lora
step control control
step long-lora long_lora

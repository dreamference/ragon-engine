# The adapters' bar, speed (bar.sh): the zero adapter against the base, the same tokens, so the ratios are the engine's
# cost alone; the base twice around it, because it drifts between runs.
source $(dirname ${BASH_SOURCE[0]})/common.sh
step base al base $B
step zero al zero $B $BASE+zero --lora-library $LIB --lora-paths zero
step base2 al base2 $B

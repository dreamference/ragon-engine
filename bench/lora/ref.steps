# The adapters' reference (agree.steps and bar.py read it): a scratch SGLang with production's flags and rand-x32 (a
# rand-split whose effect clears the noise, in LIB and in the library SGLang mounts; at --b-std 0.016 the engine without
# the adapter still passed the flip line, 91 flips against the 97 needed to fail, so the gate had no power over it):
#     make_adapter.py MODEL_DIR rand-x32 --b-std 0.064 --targets attn,gdn-split
# The fixture prompts' greedy continuations with the adapter, twice for the reference's own repeatability, the first
# teacher-forced from a cold cache (the agreement gate's reference and its self-noise), and the agent prompts' first
# answers, twice. Copies the outputs to LORA_REF (default ~/lora-ref-x32).
source $(dirname ${BASH_SOURCE[0]})/common.sh
A=$HOME/lora-agree; REF=${LORA_REF:-$HOME/lora-ref-x32}; mkdir -p $REF
# As a node launches it: the modules come from the adapter's config, every key must land (strict).
SGARGS="lora-sg --port 30000 --add enable-lora --add lora-strict-loading --set max-lora-rank 16 --set max-loras-per-batch 2
    --set lora-paths rand-x32=/root/.cache/dreamference/lora-lib/rand-x32"
SG() {
  docker rm -f lora-sg > /dev/null 2>&1
  python3 $SRC/bench/sglang/serve.py $SGARGS "$@"
}
sg_wait() {
  for i in $(seq 1 200); do
    curl -sf -m 3 localhost:30000/v1/models > /dev/null && return 0
    [ "$(docker inspect -f '{{.State.Running}}' lora-sg 2>/dev/null)" = true ] || return 1
    sleep 5
  done
  return 1
}
# Production's flags first; if SGLang refuses LoRA with them, without DFlash and torch.compile (greedy output is the
# target's either way).
sg_up() {
  SG && sg_wait && return 0
  docker logs lora-sg 2>&1 | tail -n 40; echo "=== again without speculation and torch.compile"
  SG --drop speculative-algorithm --drop speculative-draft-model-path --drop speculative-num-draft-tokens \
      --drop enable-torch-compile --drop torch-compile-max-bs && sg_wait
}
ref() {
  local U=http://127.0.0.1:30000 P="python3 $SRC/bench/agreement/prod.py"
  set -e
  RAGON_REF_URL=$U RAGON_REF_LORA=rand-x32 $P gen $A/ids.jsonl $REF/ref-lora.jsonl 48 1
  RAGON_REF_URL=$U RAGON_REF_LORA=rand-x32 $P gen $A/ids.jsonl $REF/ref-lora-run2.jsonl 48 1
  RAGON_REF_URL=$U $P flush
  RAGON_REF_URL=$U RAGON_REF_LORA=rand-x32 $P force $A/ids.jsonl $REF/ref-lora.jsonl $REF/force-lora.jsonl 1
  RAGON_REF_URL=$U RAGON_REF_LORA=rand-x32 $P gen $A/ids-long.jsonl $REF/long-lora.jsonl 400 1
  RAGON_REF_URL=$U RAGON_REF_LORA=rand-x32 $P gen $A/ids-long.jsonl $REF/long-lora-run2.jsonl 400 1
}
step sg-up sg_up
step ref ref
docker logs lora-sg > $V/sg.log 2>&1; docker rm -f lora-sg > /dev/null 2>&1
